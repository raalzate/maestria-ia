import streamlit as st
import tempfile
import os
import contextlib
import json
import copy
import warnings
import pandas as pd
from typing import Dict, Any
from streamlit_agraph import agraph, Node, Edge, Config

# --- Importaciones del proyecto ---
from config.settings import load_api_key
from graph.graph_workflow import process_event_storming_audio, process_event_storming_text
from utils.tee import Tee
from models.domain_analysis import DomainAnalysis

# --- Configuración ---
STATIC_DIR = "static"
STATIC_JSON_PATH = os.path.join(STATIC_DIR, "domain_analysis.json")
warnings.filterwarnings('ignore', message='FP16 is not supported on CPU')


# === UTILIDADES ===
def save_static_json(data: Dict):
    """Guarda el JSON en disco para persistencia entre sesiones."""
    os.makedirs(STATIC_DIR, exist_ok=True)
    with open(STATIC_JSON_PATH, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)


def _process_nodes_list(nodes_list: list, default_nivel: int) -> list:
    """Procesa una lista de nodos para limpiar tags y asegurar el campo nivel."""
    for node in nodes_list:
        # Asegurar que nivel existe
        if "nivel" not in node or node["nivel"] == "": 
            node["nivel"] = default_nivel
            
        tags = node.get("tags_tecnologia", "")
        if isinstance(tags, str):
            if tags.strip().lower() in ["none", "", "nan"]:
                node["tags_tecnologia"] = []
            else:
                node["tags_tecnologia"] = [t.strip() for t in tags.split(",") if t.strip()]
        # Si ya es lista pero vacía, dejarla como lista
        elif not isinstance(tags, list):
            node["tags_tecnologia"] = []
    return nodes_list

## BLOQUE 1: BIG PICTURE
def _reconstruct_big_picture(modified: Dict, nodes_df: pd.DataFrame, edges_df: pd.DataFrame):
    """Reconstruye la sección Big Picture."""
    bp_nodes = nodes_df[nodes_df['aggregate'] == "Big Picture"].drop(columns=['aggregate'], errors='ignore')
    bp_edges = edges_df[edges_df['aggregate'] == "Big Picture"].drop(columns=['aggregate'], errors='ignore')
    
    nodes_list = bp_nodes.to_dict('records')
    modified["big_picture"]["nodos"] = _process_nodes_list(nodes_list, default_nivel=0)
    modified["big_picture"]["aristas"] = bp_edges.to_dict('records')

## BLOQUE 2: AGREGADOS
def _reconstruct_aggregates(modified: Dict, nodes_df: pd.DataFrame, edges_df: pd.DataFrame):
    """Reconstruye la sección de Agregados."""
    for agg in modified["agregados"]:
        agg_name = agg["nombre_agregado"]
        agg_nodes = nodes_df[nodes_df['aggregate'] == agg_name].drop(columns=['aggregate'], errors='ignore')
        agg_edges = edges_df[edges_df['aggregate'] == agg_name].drop(columns=['aggregate'], errors='ignore')

        nodes_list = agg_nodes.to_dict('records')
        agg["nodos"] = _process_nodes_list(nodes_list, default_nivel=1)
        agg["aristas"] = agg_edges.to_dict('records')

## BLOQUE 3: READ MODELS
def _reconstruct_read_models(modified: Dict, read_models_df: pd.DataFrame):
    """Reconstruye la sección de Read Models."""
    modified["read_models"] = []
    for _, row in read_models_df.iterrows():
        rm = {
            "nombre": str(row["nombre"]).strip(),
            "descripcion": str(row.get("descripcion", "") or "").strip(),
            "proyecta": [p.strip() for p in str(row.get("proyecta", "")).split(",") if p.strip()],
            "ui_policies": [p.strip() for p in str(row.get("ui_policies", "")).split(";") if p.strip()],
            "tecnologias": [t.strip() for t in str(row.get("tecnologias", "")).split(",") if t.strip()]
        }
        # Asegura que el nombre no sea None, NaN o cadena vacía
        if rm["nombre"] and rm["nombre"].lower() != "nan": 
            modified["read_models"].append(rm)

## BLOQUE 4: POLÍTICAS INTER-AGREGADOS
def _reconstruct_inter_aggregate_policies(modified: Dict, policies_df: pd.DataFrame):
    """Reconstruye la sección de Políticas Inter-Agregados."""
    modified["politicas_inter_agregados"] = policies_df.to_dict('records')


def reconstruct_domain_analysis(
    original: Dict,
    nodes_df: pd.DataFrame,
    edges_df: pd.DataFrame,
    policies_df: pd.DataFrame,
    read_models_df: pd.DataFrame
) -> Dict:
    """Reconstruye el DomainAnalysis desde DataFrames editados. (Refactorizado en bloques)"""
    modified = copy.deepcopy(original)
    
    # PASO 0: Limpieza General de NaNs en DataFrames (Fundamental)
    # Esto asegura que los valores faltantes se conviertan a "" en lugar de NaN (float)
    nodes_df = nodes_df.fillna("") 
    edges_df = edges_df.fillna("")
    policies_df = policies_df.fillna("")
    read_models_df = read_models_df.fillna("")

    # --- Bloque 4: Políticas inter-agregados ---
    _reconstruct_inter_aggregate_policies(modified, policies_df)

    # --- Bloque 2: Agregados ---
    _reconstruct_aggregates(modified, nodes_df, edges_df)

    # --- Bloque 1: Big Picture ---
    _reconstruct_big_picture(modified, nodes_df, edges_df)

    # --- Bloque 3: Read Models ---
    _reconstruct_read_models(modified, read_models_df)

    return modified


def analyze_domain_data(analysis_obj: DomainAnalysis) -> Dict[str, pd.DataFrame]:
    """Extrae DataFrames para edición y estadísticas."""
    data = analysis_obj.model_dump()
    nodes, edges, policies, read_models = [], [], [], []
    technologies = set()

    # --- Big Picture ---
    bp = data["big_picture"]
    for node in bp["nodos"]:
        nodes.append({
            "aggregate": "Big Picture",
            "id": node["id"],
            "tipo_elemento": node["tipo_elemento"],
            "nombre": node["nombre"],
            "estado_comparativo": node["estado_comparativo"],
            "tags_tecnologia": ", ".join(node["tags_tecnologia"] or [])
        })
        technologies.update(node["tags_tecnologia"] or [])
    for edge in bp["aristas"]:
        edges.append({
            "aggregate": "Big Picture",
            "fuente": edge["fuente"],
            "destino": edge["destino"],
            "descripcion": edge["descripcion"],
            "estado_comparativo": edge["estado_comparativo"]
        })

    # --- Agregados ---
    for agg in data["agregados"]:
        agg_name = agg["nombre_agregado"]
        for node in agg["nodos"]:
            # Usar .get() para evitar error si 'nivel' no existe en el JSON cargado
            # Aunque la validación de Pydantic lo asegura si viene de un modelo limpio.
            node_data = {k: v for k, v in node.items() if k != "nivel"}
            node_data["nivel"] = node.get("nivel", None)
            
            nodes.append({
                "aggregate": agg_name,
                **node_data,
                "tags_tecnologia": ", ".join(node["tags_tecnologia"] or [])
            })
            technologies.update(node["tags_tecnologia"] or [])
        for edge in agg["aristas"]:
            edges.append({"aggregate": agg_name, **edge})

    # --- Políticas Inter-Agregados ---
    for p in data["politicas_inter_agregados"]:
        policies.append(p)

    # --- Read Models ---
    for rm in data["read_models"]:
        read_models.append({
            "nombre": rm["nombre"],
            "descripcion": rm.get("descripcion", "") or "",
            "proyecta": ", ".join(rm["proyecta"]),
            "ui_policies": "; ".join(rm["ui_policies"] or []),
            "tecnologias": ", ".join(rm["tecnologias"] or [])
        })

    # --- DataFrames ---
    return {
        "nodes_df": pd.DataFrame(nodes),
        "edges_df": pd.DataFrame(edges),
        "policies_df": pd.DataFrame(policies or [{"fuente": "", "destino": "", "descripcion": "", "estado_comparativo": "nuevo"}]),
        "read_models_df": pd.DataFrame(read_models or [{"nombre": "", "descripcion": "", "proyecta": "", "ui_policies": "", "tecnologias": ""}]),
        "node_types_df": pd.DataFrame(nodes)["tipo_elemento"].value_counts().reset_index(),
        "node_states_df": pd.DataFrame(nodes)["estado_comparativo"].value_counts().reset_index(),
        "edge_types_df": pd.DataFrame(edges)["descripcion"].value_counts().reset_index(),
        "technologies_df": pd.DataFrame(sorted(technologies), columns=["technology"]) if technologies else pd.DataFrame(columns=["technology"])
    }


# === APP PRINCIPAL ===
def run_streamlit_app():
    load_api_key()
    st.set_page_config(layout="wide", page_title="Análisis de Dominio", page_icon="graph")
    st.title("Agente de Análisis de Dominio")
    st.markdown("Genera, edita y visualiza modelos de dominio a partir de audio o texto.")

    # --- Cargar JSON estático ---
    if 'analysis_result' not in st.session_state:
        if os.path.exists(STATIC_JSON_PATH):
            try:
                with open(STATIC_JSON_PATH, "r", encoding="utf-8") as f:
                    loaded = json.load(f)
                analysis_obj = DomainAnalysis.model_validate(loaded)
                st.session_state.analysis_result = {
                    "analysis": analysis_obj,
                    "transcript": loaded.get("transcript", ""),
                    "logs": f"Cargado desde {STATIC_JSON_PATH}"
                }
                st.toast("Análisis cargado desde archivo.")
            except Exception as e:
                st.error(f"Error cargando JSON: {e}")
        else:
            st.session_state.analysis_result = None
        st.session_state.logs = ""

   

    # --- Pestañas de entrada ---
    tab_audio, tab_text = st.tabs(["Audio", "Texto"])

    # === AUDIO ===
    with tab_audio:
        uploaded_file = st.file_uploader("Sube audio (mp3, wav, m4a, opus)", type=["mp3", "wav", "m4a", "opus"])
        if uploaded_file and st.button("Analizar Audio", type="primary"):
            with tempfile.NamedTemporaryFile(delete=False, suffix=os.path.splitext(uploaded_file.name)[1]) as tmp:
                tmp.write(uploaded_file.getvalue())
                path = tmp.name
            st.audio(path)
            log_stream = Tee()
            status = st.empty()
            with st.spinner("Procesando audio..."):
                try:
                    with contextlib.redirect_stdout(log_stream):
                        for step in process_event_storming_audio(path, uploaded_file.name):
                            if "error" in step:
                                st.error(step["error"])
                                break
                            if "status" in step:
                                status.info(step["status"])
                            else:
                                node_name = list(step.keys())[0]
                                st.session_state.analysis_result = step[node_name]
                                st.session_state.logs = log_stream.getvalue()
                    if os.path.exists(path):
                        os.remove(path)
                    st.rerun()
                except Exception as e:
                    st.error(f"Error: {e}")

    # === TEXTO ===
    with tab_text:
        transcript = st.text_area("Pega la transcripción:", height=300, placeholder="Ej: 'El usuario ingresa a la opción...'")
        if st.button("Analizar Texto", type="primary") and transcript.strip():
            log_stream = Tee()
            with st.spinner("Analizando..."):
                try:
                    with contextlib.redirect_stdout(log_stream):
                        for step in process_event_storming_text(transcript):
                            if "error" in step:
                                st.error(step["error"])
                                break
                            st.session_state.analysis_result = step
                            st.session_state.logs = log_stream.getvalue()
                    st.rerun()
                except Exception as e:
                    st.error(f"Error: {e}")

    st.warning("El análisis se pierde al cerrar la pestaña. Descarga o guarda el JSON para persistirlo.")

    # === RESULTADOS ===
    if st.session_state.analysis_result:
        result = st.session_state.analysis_result
        if result.get("error"):
            st.error(result["error"])
            st.code(st.session_state.logs, language="log")
            return

        analysis_obj: DomainAnalysis = result["analysis"]
        data = analysis_obj.model_dump()
        data["transcript"] = result.get("transcript", "")

        # --- Botón de eliminación con confirmación ---
        if st.button("Eliminar Análisis", type="secondary"):
            if st.session_state.get("confirm_delete"):
                if os.path.exists(STATIC_JSON_PATH):
                    os.remove(STATIC_JSON_PATH)
                for k in list(st.session_state.keys()):
                    if k not in ["logs"]:
                        del st.session_state[k]
                st.success("Análisis eliminado.")
                st.rerun()
            else:
                st.session_state.confirm_delete = True
                st.warning("¿Estás seguro? Haz clic de nuevo para confirmar.")
                st.rerun()

        # --- Pestañas ---
        tabs = st.tabs(["Datos", "Grafo", "Transcripción", "JSON", "Logs", "Read Models"])

        with tabs[0]:  # Datos
            dfs = analyze_domain_data(analysis_obj)
            st.info("Edita nodos, aristas, políticas y Read Models.")

            col1, col2 = st.columns(2)
            with col1:
                st.subheader("Nodos")
                edited_nodes = st.data_editor(dfs["nodes_df"], key="edit_nodes", num_rows="dynamic")
                st.subheader("Aristas")
                edited_edges = st.data_editor(dfs["edges_df"], key="edit_edges", num_rows="dynamic")
            with col2:
                st.subheader("Políticas Inter-Agregados")
                edited_policies = st.data_editor(dfs["policies_df"], key="edit_policies", num_rows="dynamic")
                st.subheader("Read Models")
                edited_rms = st.data_editor(dfs["read_models_df"], key="edit_rms", num_rows="dynamic")

            # --- Botón: Guardar en disco ---
            if st.button("Guardar Cambios en Disco", type="secondary"):
                try:
                    modified = reconstruct_domain_analysis(data, edited_nodes, edited_edges, edited_policies, edited_rms)
                    save_static_json(modified)
                    st.success("Cambios guardados en `static/domain_analysis.json`")
                    st.rerun()
                except Exception as e:
                    st.error(f"Error al guardar: {e}")

            # --- Botón: Generar JSON Modificado ---
            if st.button("Generar JSON Modificado", type="primary"):
                try:
                    modified = reconstruct_domain_analysis(data, edited_nodes, edited_edges, edited_policies, edited_rms)
                    modified_json_str = json.dumps(modified, indent=2, ensure_ascii=False)
                    st.session_state.modified_json = modified_json_str

                    # Guardar automáticamente en disco
                    save_static_json(modified)

                    st.success("JSON modificado generado y guardado en disco.")
                except Exception as e:
                    st.error(f"Error al reconstruir: {e}")

            if "modified_json" in st.session_state:
                st.download_button(
                    "Descargar JSON Modificado",
                    st.session_state.modified_json,
                    "domain_analysis_MODIFIED.json",
                    "application/json"
                )

        with tabs[1]:  # Grafo
            st.header("Grafo de Dominio")
            nodes, edges = [], []

            view = st.selectbox("Vista:", ["Big Picture", "Agregados", "Read Models"])

            def node_style(t):
                return {
                    "Actor": ("#4C2F2F", "ellipse", 16),
                    "Sistema Externo": ("#FB98A2", "box", 14),
                    "Evento": ("#FFA07A", "box", 12),
                    "Comando": ("#87CEFA", "box", 12),
                    "Política": ("#98FB98", "diamond", 12),
                    "Read Model": ("#DDA0DD", "box", 14),
                }.get(t, ("#CCCCCC", "box", 12))

            if view == "Big Picture":
                for n in analysis_obj.big_picture.nodos:
                    color, shape, size = node_style(n.tipo_elemento)
                    nodes.append(Node(id=n.id, label=n.nombre, title=n.tipo_elemento, color=color, shape=shape, size=size * 2))
                for e in analysis_obj.big_picture.aristas:
                    edges.append(Edge(source=e.fuente, target=e.destino, label=e.descripcion))

            elif view == "Agregados":
                agg_name = st.selectbox("Agregado:", [a.nombre_agregado for a in analysis_obj.agregados])
                agg = next(a for a in analysis_obj.agregados if a.nombre_agregado == agg_name)
                for n in agg.nodos:
                    color, shape, size = node_style(n.tipo_elemento)
                    nodes.append(Node(id=n.id, label=n.nombre, title=n.tipo_elemento, color=color, shape=shape, size=size * 2))
                for e in agg.aristas:
                    edges.append(Edge(source=e.fuente, target=e.destino, label=e.descripcion))

            elif view == "Read Models":
                for rm in analysis_obj.read_models:
                    nodes.append(Node(id=rm.nombre, label=rm.nombre, title="Read Model", color="#DDA0DD", shape="box"))
                    for ev in rm.proyecta:
                        nodes.append(Node(id=ev, label=ev, title="Evento", color="#FFA07A", shape="box"))
                        edges.append(Edge(source=ev, target=rm.nombre, label="proyecta"))

            config = Config(height=700, width="100%", directed=True, physics=True, hierarchical=False)
            agraph(nodes=nodes, edges=edges, config=config)

        with tabs[2]:  # Transcripción
            st.text_area("Transcripción", result.get("transcript", ""), height=600, disabled=True)

        with tabs[3]:  # JSON
            st.json(data)
            st.download_button(
                "Descargar JSON Completo",
                json.dumps(data, indent=2, ensure_ascii=False),
                "domain_analysis.json",
                "application/json"
            )

        with tabs[4]:  # Logs
            st.code(st.session_state.logs, language="log")

        with tabs[5]:  # Read Models
            st.subheader("Read Models (Pantallas y Reportes)")
            for rm in analysis_obj.read_models:
                with st.expander(f"{rm.nombre}"):
                    st.write("**Proyecta:**", ", ".join(rm.proyecta) if rm.proyecta else "Ninguno")
                    st.write("**UI Policies:**", "; ".join(rm.ui_policies or []) if rm.ui_policies else "Ninguna")
                    st.write("**Tecnologías:**", ", ".join(rm.tecnologias or []) if rm.tecnologias else "Ninguna")


if __name__ == "__main__":
    run_streamlit_app()